{
    "name": "jardissupport/identity",
    "homepage": "https://jardis.io",
    "description": "Identity management for Jardis: users, tenants, memberships, groups, invitations, password reset and tenant switching on top of jardissupport/auth — framework-free",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Jardis Development",
            "email": "jardisDev@headgent.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "jardissupport/contracts": "^2.10",
        "jardissupport/auth": "^1.4",
        "jardissupport/dbquery": "^1.1",
        "jardissupport/repository": "^1.6",
        "jardissupport/validation": "^1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "10.5.63",
        "phpstan/phpstan": "2.2.3",
        "squizlabs/php_codesniffer": "3.13.6",
        "jardisadapter/dbconnection": "^1.2",
        "jardissupport/data": "^1.2"
    },
    "suggest": {
        "jardissupport/data": "Provides the IdentityInterface implementation (UUID v7 ids) used by the managers"
    },
    "autoload": {
        "psr-4": {
            "JardisSupport\\Identity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JardisSupport\\Identity\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/jardisSupport/identity/issues",
        "docs": "https://docs.jardis.io/en/support/identity",
        "email": "jardisDev@headgent.com"
    },
    "keywords": [
        "identity",
        "user-management",
        "tenant",
        "multi-tenancy",
        "membership",
        "invitation",
        "password-reset",
        "authentication",
        "php",
        "domain-driven-design",
        "hexagonal-architecture",
        "jardis",
        "headgent"
    ]
}
